# Get these from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Option A: string session (recommended for servers). Generate with: python gen_session.py
SESSION_STRING=

# Option B: leave SESSION_STRING empty -> file session sessions/<SESSION_NAME>.session
SESSION_NAME=userbot

# Command prefix(es), space separated. Example: ". !"
CMD_PREFIX=.

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
LOG_FILE=userbot.log

# AFK auto-reply cooldown per user (seconds)
AFK_COOLDOWN=600

# Proxy if Telegram is filtered: socks5://[user:pass@]host:port or http://host:port
PROXY=

# Web panel (empty password = disabled). Keep HOST=127.0.0.1 unless you know what you do.
PANEL_PASSWORD=
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Optional HTTPS for the panel (PEM files). Then set PANEL_HOST=0.0.0.0 to open it from your phone.
PANEL_CERT=
PANEL_KEY=
